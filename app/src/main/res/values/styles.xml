<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:colorControlActivated">@color/accent_text</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:popupMenuStyle">@style/AppPopup</item>
        <item name="android:switchStyle">@style/AppSwitch</item>
        <item name="appAccent">@color/accent_text</item>
        <item name="appAccentFill">@color/accent</item>
        <item name="appArt">@drawable/bg_art</item>
        <item name="appArtBig">@drawable/bg_art_big</item>
        <item name="appCard">@drawable/bg_card</item>
        <item name="appPillTint">@drawable/bg_pill_tint</item>
        <item name="appSearch">@drawable/bg_search</item>
        <item name="appTile">@drawable/bg_tile</item>
    </style>

    <!-- The window of a glass dialog: see-through, dimmed behind, no title. The card draws the glass. -->
    <style name="GlassDialogTheme" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="appAccent">@color/accent_text</item>
        <item name="appAccentFill">@color/accent</item>
        <item name="appArt">@drawable/bg_art</item>
        <item name="appArtBig">@drawable/bg_art_big</item>
        <item name="appCard">@drawable/bg_card</item>
        <item name="appPillTint">@drawable/bg_pill_tint</item>
        <item name="appSearch">@drawable/bg_search</item>
        <item name="appTile">@drawable/bg_tile</item>
    </style>

    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="AppPopup" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@color/surface_raised</item>
    </style>

    <!-- Switches look like iOS ones: a red track and a round white thumb. -->
    <style name="AppSwitch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:splitTrack">false</item>
        <item name="android:showText">false</item>
        <item name="android:background">@null</item>
    </style>

    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/topbar_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/gutter</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="TopTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_top_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The big bold title of a main screen, like the Library in Apple Music. -->
    <style name="LargeTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_large_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TopSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_top_subtitle</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">@dimen/icon_btn</item>
        <item name="android:layout_height">@dimen/icon_btn</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/icon</item>
    </style>

    <!-- The Equalizer button of a top bar: the moving bars, 22dp inside the 48dp touch area. -->
    <style name="EqBarsButton">
        <item name="android:layout_width">@dimen/icon_btn</item>
        <item name="android:layout_height">@dimen/icon_btn</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">13dp</item>
    </style>

    <!-- One item of the bottom tab bar: an icon above a short label (set drawableTop in the layout). -->
    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/tabbar_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:drawableTint">@color/tab_text</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">@dimen/text_tab</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- One item of the New design's slim tab bar. -->
    <style name="TabNew">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/n_tabbar_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">1dp</item>
        <item name="android:drawableTint">@color/n_tab_text</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">@dimen/n_text_tab</item>
        <item name="android:textColor">@color/n_tab_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="RowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_row_title</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="RowSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_row_sub</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/pill_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="PillAccent" parent="Pill">
        <item name="android:background">@drawable/bg_pill_accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:drawableTint">@color/on_accent</item>
    </style>

    <!-- Play and Shuffle: soft grey with red content, as in Apple Music. -->
    <style name="PillTint" parent="Pill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/appPillTint</item>
        <item name="android:textColor">?attr/appAccent</item>
        <item name="android:drawableTint">?attr/appAccent</item>
    </style>

    <!-- A small action button inside a settings card. -->
    <style name="PillSmall" parent="Pill">
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/appPillTint</item>
        <item name="android:textColor">?attr/appAccent</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PillOutline" parent="Pill">
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:drawableTint">@color/text_primary</item>
    </style>

    <style name="CtlButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/icon</item>
    </style>

    <style name="CtlSmall" parent="CtlButton">
        <item name="android:layout_height">@dimen/ctl_small</item>
        <item name="android:padding">@dimen/ctl_small_pad</item>
    </style>

    <style name="CtlMid" parent="CtlButton">
        <item name="android:layout_height">@dimen/ctl_mid</item>
        <item name="android:padding">@dimen/ctl_mid_pad</item>
    </style>

    <style name="BannerAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">?attr/appAccent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">?attr/appCard</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="SettingTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Choices shown as a row of tiles or as one switch with a few positions. -->
    <style name="SegmentRadio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- The segmented choices of the New design's Settings: rounder, with a pill for the chosen part. -->
    <style name="SegmentRadioNew" parent="SegmentRadio">
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/n_bg_segment</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TileRadio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/appTile</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- The New design, laid over AppTheme (Design.apply): a blue accent and rounder shapes. -->
    <style name="NewDesign">
        <item name="android:colorAccent">@color/n_accent</item>
        <item name="android:colorControlActivated">@color/n_accent</item>
        <item name="appAccent">@color/n_accent</item>
        <item name="appAccentFill">@color/n_accent_fill</item>
        <item name="appArt">@drawable/n_bg_art</item>
        <item name="appArtBig">@drawable/n_bg_art_big</item>
        <item name="appCard">@drawable/n_bg_card</item>
        <item name="appPillTint">@drawable/n_bg_pill_tint</item>
        <item name="appSearch">@drawable/n_bg_search</item>
        <item name="appTile">@drawable/n_bg_tile</item>
    </style>
</resources>
