<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/np_art_pad">

        <!-- The cover and the moving bars on it share one rounded, raised box. The frame around it
             gives the padding and the height; this one wraps the square cover. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_art_big"
            android:elevation="10dp"
            tools:ignore="UselessParent">

            <!-- Both children are match_parent on purpose: a FrameLayout only measures its children a
                 second time, at the size it settled on, when two or more of them ask to fill it. -->
            <com.musicplayer.lite.SquareImageView
                android:id="@+id/np_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_art_big"
                android:contentDescription="@string/cd_album_art"
                android:scaleType="centerCrop" />

            <com.musicplayer.lite.EqBarsView
                android:id="@+id/np_bars"
                android:layout_width="match_parent"
                android:layout_height="@dimen/np_bars_height"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_np_bars"
                android:importantForAccessibility="no"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                app:barColor="@color/np_bars"
                app:barGap="0.9"
                app:barRadius="0.3"
                app:barRest="0.45"
                app:bars="@integer/np_bars"
                app:spectrum="true" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/np_side_pad"
        android:paddingEnd="@dimen/np_side_pad">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/np_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_np_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/np_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_np_artist" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/np_fav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_tint"
            android:contentDescription="@string/cd_favorite_add"
            android:scaleType="center"
            android:src="@drawable/ic_favorite_border"
            android:tint="@color/icon" />

        <ImageButton
            android:id="@+id/np_more"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_tint"
            android:contentDescription="@string/cd_more"
            android:scaleType="center"
            android:src="@drawable/ic_more_horiz"
            android:tint="@color/icon" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/np_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="glass:card,margin,padded">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/np_side_pad"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/np_side_pad">

            <SeekBar
                android:id="@+id/np_seek"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressDrawable="@drawable/seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/np_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/np_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="@dimen/ctl_vpad"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/ctl_vpad">

            <ImageButton
                android:id="@+id/np_shuffle"
                style="@style/CtlSmall"
                android:contentDescription="@string/cd_shuffle"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/np_prev"
                style="@style/CtlMid"
                android:contentDescription="@string/cd_previous"
                android:src="@drawable/ic_skip_previous" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3">

                <ImageButton
                    android:id="@+id/np_play"
                    android:layout_width="@dimen/ctl_big"
                    android:layout_height="@dimen/ctl_big"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play"
                    android:contentDescription="@string/cd_play"
                    android:padding="@dimen/ctl_big_pad"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="@color/icon" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/np_next"
                style="@style/CtlMid"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_skip_next" />

            <ImageButton
                android:id="@+id/np_repeat"
                style="@style/CtlSmall"
                android:contentDescription="@string/cd_repeat"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>
    </LinearLayout>
</merge>
