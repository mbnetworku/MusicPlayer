<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/np_art_pad">

        <com.musicplayer.lite.SquareImageView
            android:id="@+id/np_art"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_art_big"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/np_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/np_side_pad"
        android:paddingEnd="@dimen/np_side_pad"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_np_title" />

    <TextView
        android:id="@+id/np_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/np_side_pad"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/np_side_pad"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_np_artist" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/np_side_pad"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/np_side_pad">

        <SeekBar
            android:id="@+id/np_seek"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:progressDrawable="@drawable/seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <TextView
                android:id="@+id/np_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/np_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="@dimen/ctl_vpad"
        android:paddingEnd="12dp"
        android:paddingBottom="@dimen/ctl_vpad">

        <ImageButton
            android:id="@+id/np_shuffle"
            style="@style/CtlSmall"
            android:contentDescription="@string/cd_shuffle"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/np_prev"
            style="@style/CtlMid"
            android:contentDescription="@string/cd_previous"
            android:src="@drawable/ic_skip_previous" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3">

            <ImageButton
                android:id="@+id/np_play"
                android:layout_width="@dimen/ctl_big"
                android:layout_height="@dimen/ctl_big"
                android:layout_gravity="center"
                android:background="@drawable/bg_play"
                android:contentDescription="@string/cd_play"
                android:padding="@dimen/ctl_big_pad"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="@color/on_accent" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/np_next"
            style="@style/CtlMid"
            android:contentDescription="@string/cd_next"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/np_repeat"
            style="@style/CtlSmall"
            android:contentDescription="@string/cd_repeat"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>
</merge>
