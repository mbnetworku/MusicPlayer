<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        style="@style/TopBar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_marginStart="6dp"
            android:tag="glass:pill"
            style="@style/IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TopTitle"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/eq_title" />

        <Switch
            android:id="@+id/eq_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/eq_switch" />
    </LinearLayout>

    <TextView
        android:id="@+id/eq_unavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/gutter"
        android:text="@string/eq_unavailable"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/eq_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="24dp">

            <!-- Moving bars while music plays; their heights follow the equalizer sliders below. -->
            <com.musicplayer.lite.EqBarsView
                android:id="@+id/eq_bars"
                android:layout_width="match_parent"
                android:layout_height="@dimen/eq_bars_height"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:tag="glass:card"
                app:barColor="@color/accent"
                app:bars="20" />

            <include layout="@layout/part_eq_device" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/eq_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:tag="glass:card,padded">

                <com.musicplayer.lite.EqCurveView
                    android:id="@+id/eq_curve"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/eq_curve_height" />

                <LinearLayout
                    android:id="@+id/eq_bands"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/eq_band_height"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="24dp"
                android:text="@string/eq_effects" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:tag="glass:card,padded">

                <include
                    android:id="@+id/fx_bass"
                    layout="@layout/row_effect" />

                <include
                    android:id="@+id/fx_virt"
                    layout="@layout/row_effect" />

                <include
                    android:id="@+id/fx_loud"
                    layout="@layout/row_effect" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/eq_reset"
                    style="@style/PillOutline"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/eq_reset" />

                <TextView
                    android:id="@+id/eq_system"
                    style="@style/PillOutline"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/eq_system" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
