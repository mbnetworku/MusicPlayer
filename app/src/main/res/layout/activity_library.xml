<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/part_library_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.musicplayer.lite.MiniPlayerView
            android:id="@+id/mini"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:tag="glass:margin"
            tools:ignore="InconsistentLayout" />

        <!-- The round search button next to the player, like Apple Music. -->
        <ImageButton
            android:id="@+id/btn_search_round"
            style="@style/IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_tint"
            android:contentDescription="@string/cd_search"
            android:src="@drawable/ic_search"
            android:tag="glass:pill" />
    </LinearLayout>

    <include
        layout="@layout/part_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
