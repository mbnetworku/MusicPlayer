<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom tab bar of the New design: Songs, Folders, Albums and Favorites in a slim glass capsule. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tabbar"
    android:orientation="horizontal"
    android:tag="glass:tabs,margin">

    <TextView
        android:id="@+id/tab_songs"
        style="@style/TabNew"
        android:drawableTop="@drawable/ic_music_note"
        android:text="@string/tab_songs" />

    <TextView
        android:id="@+id/tab_folders"
        style="@style/TabNew"
        android:drawableTop="@drawable/ic_folder_duo"
        android:text="@string/tab_folders" />

    <TextView
        android:id="@+id/tab_albums"
        style="@style/TabNew"
        android:drawableTop="@drawable/ic_album"
        android:text="@string/tab_albums" />

    <TextView
        android:id="@+id/tab_favorites"
        style="@style/TabNew"
        android:drawableTop="@drawable/ic_favorite"
        android:text="@string/tab_favorites" />
</LinearLayout>
