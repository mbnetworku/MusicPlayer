<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height"
    android:background="@drawable/bg_row"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="4dp">

    <FrameLayout
        android:layout_width="@dimen/row_art"
        android:layout_height="@dimen/row_art">

        <com.musicplayer.lite.RoundedImageView
            android:id="@+id/row_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/appArt"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <com.musicplayer.lite.EqBarsView
            app:hideWhenNone="true"
            android:id="@+id/row_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_playing"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:visibility="gone"
            app:barColor="?attr/appAccentFill"
            app:bars="4" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            style="@style/RowTitle" />

        <TextView
            android:id="@+id/row_sub"
            style="@style/RowSub"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_fav"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/cd_favorite_mark"
        android:src="@drawable/ic_favorite"
        android:tint="@color/accent_text"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/row_more"
        style="@style/IconButton"
        android:layout_width="44dp"
        android:contentDescription="@string/cd_more"
        android:src="@drawable/ic_more_horiz"
        android:tint="@color/icon_dim" />
</LinearLayout>
