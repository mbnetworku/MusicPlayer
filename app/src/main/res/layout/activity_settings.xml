<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grouped_bg"
    android:orientation="vertical"
    android:tag="glass:clear">

    <LinearLayout
        style="@style/TopBar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />
    </LinearLayout>

    <TextView
        style="@style/LargeTitle"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginBottom="4dp"
        android:text="@string/settings_title" />

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="32dp">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/set_appearance" />

            <LinearLayout
                style="@style/SettingsCard"
                android:tag="glass:card">

                <TextView
                    style="@style/SettingTitle"
                    android:paddingTop="8dp"
                    android:text="@string/set_theme" />

                <RadioGroup
                    android:id="@+id/theme_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/theme_system"
                        style="@style/SettingRadio"
                        android:text="@string/theme_system" />

                    <TextView
                        android:id="@+id/theme_system_now"
                        style="@style/SettingSub"
                        android:layout_marginTop="-6dp"
                        android:paddingStart="40dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp" />

                    <RadioButton
                        android:id="@+id/theme_light"
                        style="@style/SettingRadio"
                        android:text="@string/theme_light" />

                    <RadioButton
                        android:id="@+id/theme_dark"
                        style="@style/SettingRadio"
                        android:text="@string/theme_dark" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_glass"
                    layout="@layout/row_setting" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_bars"
                    layout="@layout/row_setting" />
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:text="@string/set_background" />

            <LinearLayout
                style="@style/SettingsCard"
                android:tag="glass:card">

                <TextView
                    style="@style/SettingSub"
                    android:paddingTop="8dp"
                    android:text="@string/set_bg_note" />

                <RadioGroup
                    android:id="@+id/bg_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/bg_plain"
                        style="@style/SettingRadio"
                        android:text="@string/set_bg_plain" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_marginTop="-6dp"
                        android:paddingStart="40dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp"
                        android:text="@string/set_bg_plain_sub" />

                    <RadioButton
                        android:id="@+id/bg_cover"
                        style="@style/SettingRadio"
                        android:text="@string/set_bg_cover" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_marginTop="-6dp"
                        android:paddingStart="40dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp"
                        android:text="@string/set_bg_cover_sub" />

                    <RadioButton
                        android:id="@+id/bg_picture"
                        style="@style/SettingRadio"
                        android:text="@string/set_bg_picture" />

                    <TextView
                        android:id="@+id/bg_picture_sub"
                        style="@style/SettingSub"
                        android:layout_marginTop="-6dp"
                        android:paddingStart="40dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp" />

                    <RadioButton
                        android:id="@+id/bg_wallpaper"
                        style="@style/SettingRadio"
                        android:text="@string/set_bg_wallpaper" />

                    <TextView
                        android:id="@+id/bg_wallpaper_sub"
                        style="@style/SettingSub"
                        android:layout_marginTop="-6dp"
                        android:paddingStart="40dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/bg_pick"
                        style="@style/PillSmall"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/bg_wallpaper_update"
                        style="@style/PillSmall"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/set_bg_update" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:text="@string/set_library" />

            <LinearLayout
                style="@style/SettingsCard"
                android:tag="glass:card">

                <include
                    android:id="@+id/row_show_all"
                    layout="@layout/row_setting" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_scan"
                    layout="@layout/row_setting" />
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:text="@string/set_updates" />

            <LinearLayout
                style="@style/SettingsCard"
                android:tag="glass:card">

                <include
                    android:id="@+id/row_version"
                    layout="@layout/row_setting" />

                <TextView
                    android:id="@+id/upd_notes_title"
                    style="@style/SectionLabel"
                    android:layout_marginTop="8dp"
                    android:text="@string/upd_notes"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/upd_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="10"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/upd_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progressDrawable="@drawable/seek_progress"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/upd_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/upd_action"
                        style="@style/PillAccent"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/upd_secondary"
                        style="@style/PillOutline"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_auto"
                    layout="@layout/row_setting" />
            </LinearLayout>

            <TextView
                style="@style/SectionLabel"
                android:text="@string/set_about" />

            <LinearLayout
                style="@style/SettingsCard"
                android:tag="glass:card">

                <TextView
                    android:id="@+id/about_text"
                    style="@style/SettingSub"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/about_source"
                    style="@style/BannerAction"
                    android:layout_marginStart="-14dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/set_source"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
