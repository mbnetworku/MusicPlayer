<?xml version="1.0" encoding="utf-8"?>
<!-- Car head units and tablets in landscape, New design: a rounded glass player panel on the left, the library on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="2"
        android:background="@drawable/bg_mini"
        android:orientation="vertical"
        android:tag="glass:card">

        <LinearLayout style="@style/TopBar">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/now_playing" />

            <ImageButton
                android:id="@+id/btn_queue"
                style="@style/IconButton"
                android:contentDescription="@string/cd_queue"
                android:src="@drawable/ic_queue_music"
                tools:ignore="InconsistentLayout" />
        </LinearLayout>

        <com.musicplayer.lite.NowPlayingView
            android:id="@+id/np"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="InconsistentLayout,NestedWeights" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        tools:ignore="NestedWeights">

        <include
            layout="@layout/part_library_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            layout="@layout/part_tabs_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
