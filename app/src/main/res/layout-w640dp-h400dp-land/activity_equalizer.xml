<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape (car): curve and band sliders on the left, presets and effects on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        style="@style/TopBar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_marginStart="6dp"
            android:tag="glass:pill"
            style="@style/IconButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TopTitle"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/eq_title" />

        <Switch
            android:id="@+id/eq_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/eq_switch" />
    </LinearLayout>

    <TextView
        android:id="@+id/eq_unavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/gutter"
        android:text="@string/eq_unavailable"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/eq_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:tag="glass:card,padded"
            tools:ignore="NestedWeights">

            <com.musicplayer.lite.EqCurveView
                android:id="@+id/eq_curve"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:ignore="NestedWeights" />

            <LinearLayout
                android:id="@+id/eq_bands"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2.4"
                android:orientation="horizontal"
                tools:ignore="NestedWeights" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_weight="2"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Moving bars while music plays; their heights follow the equalizer sliders. -->
                <com.musicplayer.lite.EqBarsView
            app:hideWhenNone="true"
                    android:id="@+id/eq_bars"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/eq_bars_height"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/appCard"
                    android:importantForAccessibility="no"
                    android:padding="16dp"
                    android:tag="glass:card"
                    app:barColor="?attr/appAccentFill"
                    app:bars="20" />

                <include layout="@layout/part_eq_device" />

                <com.musicplayer.lite.FlowLayout
                    android:id="@+id/eq_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/eq_effects" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:tag="glass:card,padded">

                    <include
                        android:id="@+id/fx_bass"
                        layout="@layout/row_effect" />

                    <include
                        android:id="@+id/fx_virt"
                        layout="@layout/row_effect" />

                    <include
                        android:id="@+id/fx_loud"
                        layout="@layout/row_effect" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/eq_reset"
                        style="@style/PillOutline"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/eq_reset" />

                    <TextView
                        android:id="@+id/eq_system"
                        style="@style/PillOutline"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/eq_system" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
